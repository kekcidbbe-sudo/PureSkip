<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Title Bar -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:text="@string/privacy_title"
        android:textAppearance="@style/TextAppearance.PureSkip.Title"
        android:background="@color/surface" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Privacy Commitment -->
            <androidx.cardview.widget.CardView
                style="@style/Widget.PureSkip.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/primary_container"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/privacy_commitment_title"
                        android:textAppearance="@style/TextAppearance.PureSkip.Subtitle"
                        android:textStyle="bold"
                        android:textColor="@color/primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/privacy_commitment"
                        android:textAppearance="@style/TextAppearance.PureSkip.Body"
                        android:lineSpacingExtra="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/privacy_no_network"
                        android:textAppearance="@style/TextAppearance.PureSkip.Body"
                        android:textColor="@color/status_on"
                        android:drawablePadding="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/privacy_no_account"
                        android:textAppearance="@style/TextAppearance.PureSkip.Body"
                        android:textColor="@color/status_on" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/privacy_no_upload"
                        android:textAppearance="@style/TextAppearance.PureSkip.Body"
                        android:textColor="@color/status_on" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/privacy_no_screenshot"
                        android:textAppearance="@style/TextAppearance.PureSkip.Body"
                        android:textColor="@color/status_on" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Permissions -->
            <androidx.cardview.widget.CardView
                style="@style/Widget.PureSkip.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/privacy_permissions_title"
                        android:textAppearance="@style/TextAppearance.PureSkip.Subtitle"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/privacy_perm_accessibility"
                        android:textAppearance="@style/TextAppearance.PureSkip.Body"
                        android:lineSpacingExtra="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/privacy_perm_apps"
                        android:textAppearance="@style/TextAppearance.PureSkip.Body"
                        android:lineSpacingExtra="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/privacy_perm_no_internet"
                        android:textAppearance="@style/TextAppearance.PureSkip.Body"
                        android:textColor="@color/status_on" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/privacy_perm_no_storage"
                        android:textAppearance="@style/TextAppearance.PureSkip.Body"
                        android:textColor="@color/status_on" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/privacy_perm_no_camera"
                        android:textAppearance="@style/TextAppearance.PureSkip.Body"
                        android:textColor="@color/status_on" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/privacy_perm_no_location"
                        android:textAppearance="@style/TextAppearance.PureSkip.Body"
                        android:textColor="@color/status_on" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/privacy_perm_no_contacts"
                        android:textAppearance="@style/TextAppearance.PureSkip.Body"
                        android:textColor="@color/status_on" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Data Scope -->
            <androidx.cardview.widget.CardView
                style="@style/Widget.PureSkip.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/privacy_data_scope_title"
                        android:textAppearance="@style/TextAppearance.PureSkip.Subtitle"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/privacy_data_scope_desc"
                        android:textAppearance="@style/TextAppearance.PureSkip.Body"
                        android:lineSpacingExtra="6dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
