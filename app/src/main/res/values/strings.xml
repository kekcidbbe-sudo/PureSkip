    <string name="app_name">纯净跳过</string>
    <string name="app_name_debug">纯净跳过(Debug)</string>

    <!-- Accessibility Service -->
    <string name="accessibility_service_description">纯净跳过需要此权限来识别并自动点击其他应用中的\"跳过\"或\"关闭\"广告按钮。\n\n• 所有识别和操作仅在您的手机本地完成\n• 不保存页面内容，不截图，不上传任何数据\n• 本应用没有网络权限，完全离线运行\n• 您可以随时关闭此服务</string>

    <!-- First Launch Guide -->
    <string name="guide_welcome_title">欢迎使用纯净跳过</string>
    <string name="guide_welcome_desc">自动跳过应用启动广告，让每次打开应用都干干净净。</string>
    <string name="guide_what_it_does_title">它能做什么</string>
    <string name="guide_what_it_does_desc">• 自动识别并点击已适配应用的\"跳过\"按钮\n• 支持腾讯视频、爱奇艺、番茄小说等10款热门应用\n• 仅在应用启动后的10秒内工作，不影响正常使用</string>
    <string name="guide_what_it_cannot_title">它不能做什么</string>
    <string name="guide_what_it_cannot_desc">• 不能拦截所有广告（只处理有明确\"跳过\"按钮的启动广告）\n• 不会删除页面内的广告元素\n• 不保证对所有应用的所有版本都有效</string>
    <string name="guide_privacy_title">隐私保障</string>
    <string name="guide_privacy_desc">• 没有网络权限，完全离线运行\n• 不收集、不保存、不上传您的任何个人数据\n• 不使用截图、OCR或AI识别\n• 无障碍节点仅用于即时匹配，匹配后立即丢弃\n• 卸载后所有本地数据完全删除</string>
    <string name="guide_risk_title">风险说明</string>
    <string name="guide_risk_desc">开启无障碍服务后，Android 会允许本应用读取当前页面的控件信息并代替您点击按钮。\n\n我们只点击经过验证的\"跳过/关闭\"按钮，但仍有可能因应用更新导致误识别。\n\n您可以随时关闭无障碍服务或一键暂停所有功能。</string>
    <string name="guide_agree_checkbox">我已阅读并理解上述说明和风险</string>
    <string name="guide_agree_button">同意并开启服务</string>
    <string name="guide_skip_button">先看看再说</string>

